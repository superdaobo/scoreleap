{
  "name": "scoreleap",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter scoreleap-app dev",
    "build": "pnpm --filter scoreleap-app build",
    "tauri": "pnpm --filter scoreleap-app tauri",
    "lint": "pnpm --filter scoreleap-app lint",
    "typecheck": "pnpm --filter scoreleap-app typecheck",
    "test": "pnpm --filter scoreleap-app test",
    "test:e2e": "pnpm --filter scoreleap-app test:e2e",
    "video:studio": "pnpm --filter scoreleap-video studio",
    "video:studio:local": "pnpm --filter scoreleap-video studio:local",
    "video:prepare:local": "pnpm --filter scoreleap-video prepare:local",
    "video:render": "pnpm --filter scoreleap-video render",
    "video:render:local": "pnpm --filter scoreleap-video render:local",
    "video:still": "pnpm --filter scoreleap-video still",
    "prepare:transkun": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/transkun-worker/Prepare-TranskunWorker.ps1",
    "test:transkun-bundle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/transkun-worker/Test-TranskunBundle.ps1 -AllowPlaceholder"
  }
}





